generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?  @default("Abu Tahir Sk")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("admin_users")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
}

model Project {
  id                 String        @id @default(cuid())
  title              String
  slug               String        @unique
  shortDescription   String
  description        String        @db.Text
  coverImageUrl      String
  coverImagePublicId String?
  screenshots        String[]      @default([])
  technologies       String[]      @default([])
  features           String[]      @default([])
  category           String        @default("Full-Stack")
  githubUrl          String?
  liveDemoUrl        String?
  featured           Boolean       @default(false)
  status             ProjectStatus @default(PUBLISHED)
  completedAt        DateTime?
  displayOrder       Int           @default(0)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, featured])
  @@index([slug])
  @@map("projects")
}

model Skill {
  id           String   @id @default(cuid())
  name         String
  category     String   // "Frontend", "Backend", "Database", "Tools"
  icon         String?
  displayOrder Int      @default(0)
  visible      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([category, visible])
  @@map("skills")
}

model Experience {
  id           String    @id @default(cuid())
  role         String
  organization String
  description  String    @db.Text
  startDate    String
  endDate      String?
  current      Boolean   @default(false)
  technologies String[]  @default([])
  displayOrder Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@map("experiences")
}

model Education {
  id                String   @id @default(cuid())
  qualification     String
  institution       String
  subject           String?
  boardOrUniversity String?
  passingYear       String?
  description       String?  @db.Text
  startDate         String?
  endDate           String?
  displayOrder      Int      @default(0)
  visible           Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([visible, displayOrder])
  @@map("educations")
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
  @@map("contact_messages")
}

model SiteSettings {
  id                  String   @id @default("default-settings")
  fullName            String   @default("Abu Tahir Sk")
  professionalTitle   String   @default("Full-Stack Web Developer")
  biography           String   @db.Text
  profileImageUrl     String?
  profileImagePublicId String?
  avatarUrl           String?
  email               String   @default("abutahir2626@gmail.com")
  githubUrl           String   @default("https://github.com/abu-tahir-sk")
  linkedinUrl         String   @default("https://www.linkedin.com/in/abu-tahir-sk-739036352")
  availabilityStatus  String   @default("Available for hire & full-time roles")
  resumeUrl           String?
  siteUrl             String   @default("https://abutahir.dev")
  seoTitle            String   @default("Abu Tahir Sk — Full-Stack Web Developer Portfolio")
  seoDescription      String   @default("Portfolio of Abu Tahir Sk, a Full-Stack Web Developer specializing in React, Next.js, TypeScript, PostgreSQL, and Node.js.")
  socialImageUrl      String?
  footerText          String   @default("Crafted with Next.js, Prisma, and Tailwind CSS.")
  updatedAt           DateTime @updatedAt

  @@map("site_settings")
}
