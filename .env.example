# Database Connection (PostgreSQL - Neon, Supabase, or Local PostgreSQL)
DATABASE_URL="postgresql://user:password@ep-sample-pooler.c-13.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Authentication Secret (Generate with `openssl rand -hex 32`)
AUTH_SECRET="your-32-byte-hex-secret-here"

# Initial Admin Bootstrap Credentials (Used during prisma seed)
ADMIN_EMAIL="admin@example.com"
ADMIN_INITIAL_PASSWORD="ChangeThisPassword123!"

# Public Site URL (e.g., https://abutahir.dev or http://localhost:3000)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Optional Cloudinary Configuration (Leaves empty for local filesystem uploads in /public/uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional Resend API Key for Email Notifications on Contact Submissions
RESEND_API_KEY=""
CONTACT_EMAIL_NOTIFICATION="your-notification-email@example.com"
